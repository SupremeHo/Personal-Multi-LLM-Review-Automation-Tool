{
    "workbench.colorTheme": "Dark+",
    "editor.suggestSelection": "first",
    "security.workspace.trust.untrustedFiles": "open",
    "files.insertFinalNewline": true,
    "workbench.editorAssociations": {
        "*.bin": "default"
    },
    "editor.unicodeHighlight.nonBasicASCII": false,
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.wordWrap": "on",
    "editor.largeFileOptimizations": false,
    "diffEditor.maxComputationTime": 0,
    "python.defaultInterpreterPath": "C:\\Users\\suho9\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
    "python.languageServer": "Pylance",
    "workbench.editor.empty.hint": "hidden",
    "git.openRepositoryInParentFolders": "never",
    "workbench.editor.enablePreview": false,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "resharper.region.region": "Asia",
    "resharper.dataSharing.allowDataSharing": false,
    "claudeCode.preferredLocation": "panel",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": true
    },
    "resharper.solutionExplorer.trackActiveItem": true,
    "python.analysis.aiCodeActions": {
        "implementAbstractClasses": true,
        "generateSymbol": true,
        "convertFormatString": true
    },
}
